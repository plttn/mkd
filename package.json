{
  "name": "@plttn/mkd",
  "version": "0.2.3",
  "description": "A tool for managing markdown blog posts",
  "scripts": {
    "dev": "tsx ./src/index.ts",
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "ci:publish": "pnpm build && changeset publish"
  },
  "type": "module",
  "bin": {
    "mkd": "dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@changesets/cli": "2.31.1",
    "@types/node": "25.9.5",
    "prettier": "3.9.6",
    "tsdown": "0.22.14",
    "tsx": "4.23.9",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "@sindresorhus/slugify": "^3.0.0",
    "cmd-ts": "^0.15.0",
    "filenamify": "^7.0.1",
    "@11ty/gray-matter": "^2.0.2",
    "pwd-fs": "^3.5.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/plttn/mkd.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
