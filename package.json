{
  "name": "@plttn/mkd",
  "version": "0.2.2",
  "description": "A tool for managing markdown blog posts",
  "scripts": {
    "dev": "tsx ./src/index.ts",
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "ci:publish": "pnpm build && changeset publish"
  },
  "type": "module",
  "bin": {
    "mkd": "dist/index.cjs"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@11.3.0",
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^25.9.1",
    "prettier": "3.8.3",
    "tsdown": "^0.22.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "@sindresorhus/slugify": "^3.0.0",
    "cmd-ts": "^0.15.0",
    "filenamify": "^7.0.1",
    "gray-matter": "^4.0.3",
    "pwd-fs": "^3.5.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/plttn/mkd.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
